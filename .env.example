# Server Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
# Get this from your Atlas Dashboard under Database > Connect > Drivers > Node.js
# Make sure to whitelist your own IP before connecting
MONGODB_URI=replace-with-your-mongodb-atlas-uri

# JWT secrets (use strong random strings in production)
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production

# Server
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Node environment
NODE_ENV=development
