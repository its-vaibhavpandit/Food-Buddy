# ─── Server Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
# Get this from: Atlas Dashboard → Database → Connect → Drivers → Node.js
# Make sure to whitelist your IP: 49.156.85.16/32
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/fastfood-buddy?retryWrites=true&w=majority

# JWT secrets (use strong random strings in production)
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production

# Server
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Node environment
NODE_ENV=development
