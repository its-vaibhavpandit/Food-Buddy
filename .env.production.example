# =========================================================================
# Fast Food Buddy — Production Express Server Environment Variables Template
# =========================================================================

# Node environment mode
NODE_ENV=production

# Server Port
PORT=5000

# Client React Application domain (for CORS security headers)
CLIENT_URL=https://fastfoodbuddy.in

# MongoDB Production Connection URI (set this in your hosting provider)
MONGODB_URI=<your-mongodb-atlas-uri>

# Security Keys — DO NOT use default development values! Must be long, high-entropy secrets.
# Generate via: openssl rand -base64 32
JWT_SECRET=super-secret-high-entropy-jwt-access-key-goes-here
JWT_REFRESH_SECRET=super-secret-high-entropy-jwt-refresh-key-goes-here

# Merchant payment configuration
# Scannable UPI ID for payments (default is linked to 7991627968@mbk)
UPI_ID=7991627968@mbk
